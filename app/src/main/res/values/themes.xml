<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.TradeUp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/surface</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@color/surface</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/primary</item>

        <!-- Background colors -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Error color -->
        <item name="colorError">@color/error</item>

        <!-- Customize buttons -->
        <item name="materialButtonStyle">@style/Widget.TradeUp.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.TradeUp.Button.Outlined</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.TradeUp.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.TradeUp.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Bottom Navigation Style -->
    <style name="Widget.TradeUp.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.TradeUp.BottomNavigationView</item>
    </style>

    <style name="ThemeOverlay.TradeUp.BottomNavigationView" parent="">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnSurface">@color/text_secondary</item>
    </style>
</resources>