<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Main Image -->
        <ImageView
            android:id="@+id/ivDetailImage"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:scaleType="centerCrop"
            android:contentDescription="Ảnh bài đăng"
            android:background="@drawable/edittext_background"
            android:layout_marginBottom="16dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvDetailTitle"
            android:text="Tiêu đề bài đăng"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1a1a1a"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- ✅ NEW: Price -->
        <TextView
            android:id="@+id/tvDetailPrice"
            android:text="💰 25,000,000 ₫"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#d32f2f"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- Category & Condition -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvDetailCategory"
                android:text="📂 Đồ điện tử"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvDetailCondition"
                android:text="✨ Như mới"
                android:textSize="14sp"
                android:textColor="#4CAF50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Owner Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="@drawable/edittext_background"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivOwnerAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_avatar_placeholder"
                android:background="@drawable/avatar_circle_bg"
                android:contentDescription="Seller Avatar" />

            <TextView
                android:id="@+id/tvOwnerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤 Seller Name"
                android:textSize="16sp"
                android:textColor="#1a1a1a"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/tvDetailDescription"
            android:text="Mô tả chi tiết..."
            android:textSize="16sp"
            android:textColor="#333333"
            android:lineSpacingExtra="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <!-- Share Button -->
        <Button
            android:id="@+id/btnShare"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="📤 Chia sẻ bài đăng"
            android:textSize="16sp"
            android:backgroundTint="@color/blue_500"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>